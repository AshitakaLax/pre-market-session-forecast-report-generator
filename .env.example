# TypeScript app -> Amazon Chronos-2 inference service.
# Automatically connects to the public Hugging Face Chronos-2 service when CHRONOS_SERVICE_URL is unset.
PUBLIC_CHRONOS_SERVICE_URL="https://equinai-chronos-2-api.hf.space"

# Optional private/local Chronos-2 service override (takes priority if running).
CHRONOS_SERVICE_URL=""

# Set the same random token in the TypeScript app and the Python service.
# Leave empty when using the public service or local development on a trusted machine.
CHRONOS_API_TOKEN=""

# Python Chronos-2 service settings (set in the Python service environment).
CHRONOS_MODEL_ID="amazon/chronos-2"
CHRONOS_DEVICE="cpu"
CHRONOS_CONTEXT_LENGTH="8192"
CHRONOS_DIRECT_HORIZON="64"
CHRONOS_SIMULATIONS="10000"
CHRONOS_BLOCK_LENGTH="5"
CHRONOS_CPU_THREADS="4"

# The yfinance adapter is intended for personal/research use only.
MARKET_DATA_CACHE_SECONDS="600"
